	local function scanExternal()
	    table.clear(externalNames)
	    for billboard in pairs(billboardSet) do
	        if not billboard.Parent then
	            billboardSet[billboard] = nil
	        elseif not OWN_BILLBOARDS[billboard.Name] and billboard.Adornee then
	            local model = billboard.Adornee:FindFirstAncestorOfClass("Model")
	            local label = billboard:FindFirstChildWhichIsA("TextLabel", true)
	            if model and label and label.Text ~= "" then
	                externalNames[model] = clean(label.Text)
	            end
	        end
	    end
	end

