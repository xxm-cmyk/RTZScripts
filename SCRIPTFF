	local function refreshLizard(rec)
	    if rec.nextRead and os.clock() < rec.nextRead then return end
	    rec.nextRead = os.clock() + 3

	    local tierValue = rec.inst:GetAttribute("Tier") or rec.inst:GetAttribute("Level") or rec.inst:GetAttribute("Category")
	    if not tierValue then
	        local tierObject = rec.inst:FindFirstChild("Tier") or rec.inst:FindFirstChild("Level") or rec.inst:FindFirstChild("Category")
	        if tierObject and tierObject.Value then tierValue = tierObject.Value end
	    end
	    local tierNumber = tonumber(tierValue)
	    if not tierNumber and type(tierValue) == "string" then
	        tierNumber = tonumber(string.match(tierValue, "%d+"))
	    end

	    local sp = UIKit.resolveSpecies and UIKit.resolveSpecies(rec.inst) or nil
	    rec.tierNum = tierNumber and ("T" .. tostring(tierNumber)) or (sp and sp.Tier and tostring(sp.Tier)) or "T1"

	    local names, legend, legendText, weightText = readTags(rec.inst)
	    local weight = weightText
	    if not weight and sp and UIKit.getWeightKg then
	        local kg = UIKit.getWeightKg(rec.inst, sp)
	        if kg then weight = UIKit.formatKg(kg) .. " كجم" end
	    end
	    rec.weight = weight
	    local nameText = names[1] or externalNames[rec.inst]
	    local base = (sp and sp.Ar) or nameText or TYPE_NAMES[rec.type] or rec.type
	    if legendText and not base:find(legendText, 1, true) then
	        base = base .. " | " .. legendText
	    end
	    rec.name = (tostring(base):gsub("%s*[\r\n]+%s*", " "))
	    rec.rare = (legend or RARE_TYPES[rec.type] or matchRare(rec.type)
	        or (nameText and matchRare(nameText)) or (legendText and matchRare(legendText))
	        or (sp and sp.Ar and matchRare(sp.Ar))) and true or false

	    if rec.rare and not rec.announced then
	        rec.announced = true
	        if not announcedNames[rec.inst.Name] then
	            announcedNames[rec.inst.Name] = true
	            announce(rec)
	        end
	    end
	end

	local function looksLikeLizard(model, lenient)
	    if lenient and model:FindFirstChildWhichIsA("BasePart", true) then return true end
	    return model:FindFirstChild("Body", true) ~= nil or model:FindFirstChild("Hitbox", true) ~= nil
	end

	local function registerLizard(model, lenient)
	    if not running or recs[model] or pendingModels[model] or not model:IsA("Model") then return end
	    if not lenient and not model.Name:match("^.+_%x%x%x%x%x%x$") and not matchRare(model.Name) then return end
	    pendingModels[model] = true
	    local ready = false
	    for _ = 1, 8 do
	        task.wait(0.4)
	        if not running or not model.Parent then pendingModels[model] = nil; return end
	        if looksLikeLizard(model, lenient) then ready = true; break end
	    end
	    pendingModels[model] = nil
	    if not ready then return end
	    local root, pos = getRoot(model), getPos(model)
	    if not root or not pos then return end
	    local rec = {
	        inst = model, root = root, pos = pos, loaded = true,
	        type = getType(model), tierNum = "T1",
	    }
	    for key, other in pairs(recs) do
	        if not other.loaded and other.type == rec.type and (other.pos - pos).Magnitude < 150 then
	            rec.announced = other.announced
	            recs[key] = nil
	        end
	    end
	    recs[model] = rec
	    refreshLizard(rec)
	    rec.conn = model.AncestryChanged:Connect(function()
	        if not model:IsDescendantOf(workspace) then onGone(rec) end
	    end)
	end

	local function watch(folder, onAdd)
	    local function handle(child)
	        if child:IsA("Folder") then watch(child, onAdd) else task.spawn(onAdd, child) end
	    end
	    for _, child in ipairs(folder:GetChildren()) do handle(child) end
	    connect(folder.ChildAdded, handle)
	end

	local function updateAll()
	    if os.clock() - lastExternal > 3 then lastExternal = os.clock(); pcall(scanExternal) end
	    for key, rec in pairs(recs) do
	        if rec.loaded and rec.inst.Parent then
	            rec.pos = getPos(rec.inst) or rec.pos
	            refreshLizard(rec)
	        elseif not rec.loaded and os.clock() - (rec.lostAt or 0) > (rec.rare and 1800 or 600) then
	            recs[key] = nil
	        end
	    end
	end

