		knobCorner.Parent = knob

		local function updateVisual()
			local pct = math.clamp((Settings[key] - minVal) / (maxVal - minVal), 0, 1)
			fill.Size = UDim2.new(pct, 0, 1, 0)
			label.Text = titleText .. ": " .. tostring(math.floor(Settings[key])) .. suffix
		end

		local isDragging = false
		track(track_.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				isDragging = true
			end
		end))

		track(userInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				if isDragging then
					isDragging = false
					SaveSettings()
				end
			end
		end))

		track(userInputService.InputChanged:Connect(function(input)
			if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local absPos = track_.AbsolutePosition
				local absSize = track_.AbsoluteSize
				local pct = math.clamp((input.Position.X - absPos.X) / absSize.X, 0, 1)
				Settings[key] = math.floor(minVal + pct * (maxVal - minVal))
				updateVisual()
				if callback then callback(Settings[key]) end
			end
		end))

		updateValue = function()
			updateVisual()
		end

		updateVisual()
		return row, updateValue
	end

