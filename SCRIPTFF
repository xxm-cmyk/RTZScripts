		tweenService:Create(button, TweenInfo.new(0.15), {TextColor3 = Color3.fromRGB(205, 205, 220)}):Play()
	end)
	button.MouseLeave:Connect(function()
		if pages[name].Visible then return end
		tweenService:Create(button, TweenInfo.new(0.15), {TextColor3 = Color3.fromRGB(150, 150, 165)}):Play()
	end)

