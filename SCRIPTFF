	local function getMeshKey(model)
		local body = model:FindFirstChild("Body")
		if not body then
			return nil
		end
		if body:IsA("MeshPart") then
			local meshId = tostring(body.MeshId):match("%d+")
			if meshId and meshId ~= "" then
				return meshId
			end
		end
		local attr = body:GetAttribute("MeshAssetId")
		if attr then
			return tostring(attr):match("%d+")
		end
		return nil
	end

	local function resolveSpecies(model)
		if not Species then
			return nil
		end

		local key = getMeshKey(model)
		local ids = key and meshToSpeciesIds[key]
		if not ids or #ids == 0 then
			return nil
		end

		local tier = tostring(model:GetAttribute("Tier") or "")
		local length = tonumber(model:GetAttribute("Length"))

		local pool = {}
		for _, id in ipairs(ids) do
			local sp = Species.ById[id]
			if sp and (tier == "" or sp.Tier == tier) then
				table.insert(pool, sp)
			end
		end
		if #pool == 0 then
			for _, id in ipairs(ids) do
				local sp = Species.ById[id]
				if sp then
					table.insert(pool, sp)
				end
			end
		end
		if #pool <= 1 then
			return pool[1]
		end

		if length then
			local inside = {}
			for _, sp in ipairs(pool) do
				local lo, hi = tonumber(sp.LenMin), tonumber(sp.LenMax)
				if lo and hi and length >= lo - 0.05 and length <= hi + 0.05 then
					table.insert(inside, sp)
				end
			end
			if #inside >= 1 then
				pool = inside
			end
		end

		local normal = {}
		for _, sp in ipairs(pool) do
			local isEvent = false
			for _, where in ipairs(sp.Where or {}) do
				if where == "event" then
					isEvent = true
					break
				end
			end
			if not isEvent then
				table.insert(normal, sp)
			end
		end
		if #normal == 1 then
			return normal[1]
		elseif #normal > 1 then
			pool = normal
		end

		local best, bestDiff = pool[1], math.huge
		for _, sp in ipairs(pool) do
			local lo, hi = tonumber(sp.LenMin), tonumber(sp.LenMax)
			if lo and hi then
				local mid = (lo + hi) / 2
				local diff = math.abs((length or mid) - mid)
				if diff < bestDiff then
					best, bestDiff = sp, diff
				end
			end
		end
		return best
	end

	local function getWeightKg(model, sp)
		if not sp then
			return nil
		end
		local length = tonumber(model:GetAttribute("Length"))
		local lo, hi = tonumber(sp.LenMin), tonumber(sp.LenMax)
		local kgLo, kgHi = tonumber(sp.KgMin), tonumber(sp.KgMax)
		if not length or not lo or not hi or not kgLo or not kgHi then
			return kgLo
		end
		if hi <= lo then
			return kgLo
		end
		local ratio = math.clamp((length - lo) / (hi - lo), 0, 1)
		return kgLo + ratio * (kgHi - kgLo)
	end

	local function formatKg(kg)
		if not kg then
			return "؟"
		end
		if kg >= 100 then
			return string.format("%.0f", kg)
		elseif kg >= 10 then
			return string.format("%.1f", kg)
