	local function findAimTarget(cam)
		local center = cam.ViewportSize / 2
		local maxStuds = Settings.AimMaxMetres / METRES_PER_STUD
		local best, bestScore = nil, math.huge

		for _, folderName in ipairs({"DhabWild", "DhabLegends"}) do
			local folder = workspace:FindFirstChild(folderName)
			if folder then
				for _, model in ipairs(folder:GetChildren()) do
					local part = model:FindFirstChild("Hitbox") or model:FindFirstChild("Body")
					if part and part:IsA("BasePart") and part.Parent then
						local distance = (part.Position - cam.CFrame.Position).Magnitude
						if distance <= maxStuds then
							local screen, onScreen = cam:WorldToViewportPoint(part.Position)
							if onScreen and screen.Z > 0 then
								local score = (Vector2.new(screen.X, screen.Y) - center).Magnitude
								if score <= Settings.AimFovRadius and score < bestScore then
									best, bestScore = model, score
								end
							end
						end
					end
				end
			end
		end
		return best
	end

	local function aimStep(dt)
		if not running then return end
		local cam = workspace.CurrentCamera
		if not cam then return end

		local isAimingInput = Settings.MobileAim or aimIsRmbDown
		local canAim = Settings.AimbotGeneral and getHeldWeapon() ~= nil and isAimingInput

		local target
		if canAim then
			target = findAimTarget(cam)
			if target then
				local part = target:FindFirstChild("Hitbox") or target:FindFirstChild("Body")
				if part then
					local goal = CFrame.lookAt(cam.CFrame.Position, part.Position)
					local strength = math.clamp(Settings.AimStrength / 100, 0.01, 1)
					if strength >= 0.999 then
						cam.CFrame = goal
					else
						local alpha = 1 - (1 - strength) ^ (math.max(dt, 0.001) * 60)
						cam.CFrame = cam.CFrame:Lerp(goal, alpha)
					end
				end
			end
		end

		ensureAimDrawings()
		if aimDrawGlow and aimDrawRing then
			local center = cam.ViewportSize / 2
			local pulse = 0
			if target then pulse = math.sin(os.clock() * 6) * 2 end
			local color = target and Color3.fromRGB(120, 255, 150) or Color3.fromRGB(80, 205, 255)

			aimDrawGlow.Position = center
			aimDrawGlow.Radius = Settings.AimFovRadius + 2 + pulse
			aimDrawGlow.Color = color
			aimDrawGlow.Visible = Settings.AimbotGeneral and Settings.AimShowFov

			aimDrawRing.Position = center
			aimDrawRing.Radius = Settings.AimFovRadius
			aimDrawRing.Visible = Settings.AimbotGeneral and Settings.AimShowFov
		end

		if aimDrawLock then
			local lockVisible = false
			if target then
				local part = target:FindFirstChild("Hitbox") or target:FindFirstChild("Body")
				if part then
					local screen, onScreen = cam:WorldToViewportPoint(part.Position)
					if onScreen and screen.Z > 0 then
						aimDrawLock.Position = Vector2.new(screen.X, screen.Y)
						lockVisible = true
					end
				end
			end
			aimDrawLock.Visible = Settings.AimbotGeneral and lockVisible
		end
	end

