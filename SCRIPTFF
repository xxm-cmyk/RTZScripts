		local target = selected
		local live = (target.loaded and target.inst.Parent) and getPos(target.inst) or nil
		task.spawn(function()
			tpBtn.Text = "✖ إلغاء التنقل"
			local ok = teleportTo(live or target.pos)
			if tpBtn.Parent then tpBtn.Text = "⚡ تنقل للهدف" end
			setNote(ok and ("تم الوصول إلى: " .. (target.name or "")) or "توقف التنقل", 3)
		end)
	end)
	tpBtn.TextColor3 = GOLD

	for _, name in ipairs(LIZARD_FOLDERS) do
		task.spawn(function()
			local folder = workspace:WaitForChild(name, 10)
			if folder and running then
				watch(folder, function(model) registerLizard(model, name ~= "DhabWild") end)
			end
		end)
	end

	task.spawn(function()
		trackBillboards(localPlayer:FindFirstChildOfClass("PlayerGui"))
		trackBillboards(workspace.CurrentCamera)
	end)

	task.spawn(function()
		while running do
			pcall(updateAll)
			if finderPage.Visible then pcall(refreshList) end
			task.wait(1)
		end
	end)

	track(runService.RenderStepped:Connect(function()
		if not finderPage.Visible then return end
		local pulse = 0.5 + 0.5 * math.sin(os.clock() * 4)
		for rec, row in pairs(rows) do
			if rec.rare and selected ~= rec then
				row.stroke.Transparency = 0.1 + 0.5 * (1 - pulse)
			end
		end
	end))

	table.insert(featureCleanups, function()
		stopSweep = true
		tpToken += 1
		clearTpControllers()
		for _, rec in pairs(recs) do
			if rec.conn then rec.conn:Disconnect() end
		end
	end)
end


openMain()
