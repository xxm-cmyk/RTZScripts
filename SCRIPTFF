	        local vehicle = seat:FindFirstAncestorOfClass("Model")
	        if vehicle then
	            while vehicle.Parent and vehicle.Parent:IsA("Model") do
	                vehicle = vehicle.Parent
	            end
	            return vehicle, seat.AssemblyRootPart or seat
	        end
	    end
	    return char, char:FindFirstChild("HumanoidRootPart")
	end

	local tpVelocity, tpGyro

	local function clearTpControllers()
	    if tpVelocity then tpVelocity:Destroy(); tpVelocity = nil end
	    if tpGyro then tpGyro:Destroy(); tpGyro = nil end
	end

	local function runTeleport(targetPos)
	    tpToken += 1
	    local token = tpToken
	    local unit, root = getMoveTarget()
	    if not unit or not root then return false end

	    streamAround(targetPos, 1.5)
	    if token ~= tpToken then return false end

	    clearTpControllers()

	    tpGyro = Instance.new("BodyGyro")
	    tpGyro.P = 9e4
	    tpGyro.maxTorque = Vector3.new(9e5, 9e5, 9e5)
	    tpGyro.cframe = root.CFrame
	    tpGyro.Parent = root

	    tpVelocity = Instance.new("BodyVelocity")
	    tpVelocity.velocity = Vector3.zero
	    tpVelocity.maxForce = Vector3.new(9e5, 0, 9e5)
	    tpVelocity.Parent = root

	    local startedAt = os.clock()
	    local lastPos = root.Position
	    local stuckTime = 0

	    while running and token == tpToken do
	        unit, root = getMoveTarget()
	        if not unit or not root or not tpVelocity or tpVelocity.Parent ~= root then break end

	        local currentPos = root.Position
	        local char = localPlayer.Character

	        if (Vector3.new(currentPos.X, 0, currentPos.Z) - Vector3.new(lastPos.X, 0, lastPos.Z)).Magnitude < 0.3 then
	            stuckTime += 0.1
	            if stuckTime > 0.3 and char then
	                for _, part in ipairs(char:GetDescendants()) do
	                    if part:IsA("BasePart") then part.CanCollide = false end
	                end
	            end
	        else
	            stuckTime = 0
	            if char then
	                for _, part in ipairs(char:GetDescendants()) do
	                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then part.CanCollide = true end
	                end
	            end
	        end
	        lastPos = currentPos

	        local flatTarget = Vector3.new(targetPos.X, currentPos.Y, targetPos.Z)
	        local direction = flatTarget - currentPos
	        if direction.Magnitude < 5 or os.clock() - startedAt > 60 then break end

	        tpGyro.cframe = CFrame.lookAt(currentPos, flatTarget)
	        tpVelocity.velocity = Vector3.new(direction.Unit.X * Settings.FinderTpSpeed, 0, direction.Unit.Z * Settings.FinderTpSpeed)
	        runService.Heartbeat:Wait()
	    end

	    clearTpControllers()
	    pcall(function()
	        for _, part in ipairs(localPlayer.Character:GetDescendants()) do
	            if part:IsA("BasePart") then part.CanCollide = true end
	        end
	    end)
	    return token == tpToken
	end

	local function teleportTo(position)
	    tpBusy += 1
	    local ok, result = pcall(runTeleport, position)
	    tpBusy -= 1
	    if tpBusy == 0 then
	        local _, root = getMoveTarget()
	        if root then root.AssemblyLinearVelocity = Vector3.zero end
	        clearTpControllers()
	    end
	    return ok and result or false
	end

	local OWN_BILLBOARDS = {DFMark = true, DhabESP_Billboard = true, DhabBurrowESP = true, Sairo_Text = true, RTZ_WT_Text = true}

	local function onGone(rec)
	    local origin = getOrigin()
	    local nearby = origin ~= nil and rec.pos ~= nil
	        and (rec.pos - origin.Position).Magnitude <= CATCH_DISTANCE
	    if rec.conn then rec.conn:Disconnect(); rec.conn = nil end
	    rec.loaded = false
	    rec.lostAt = os.clock()
	    if nearby then recs[rec.inst] = nil end
	end

	local function readTags(model)
	    local names, legend, legendText, weightText = {}, false, nil, nil
	    for _, descendant in ipairs(model:GetDescendants()) do
	        if descendant:IsA("BillboardGui") and not OWN_BILLBOARDS[descendant.Name] then
	            local isLegend = descendant.Name:lower():find("legend", 1, true) ~= nil
	            legend = legend or isLegend
	            for _, label in ipairs(descendant:GetDescendants()) do
	                if label:IsA("TextLabel") and label.Text ~= "" then
	                    local value = clean(label.Text)
	                    if value:match("كجم") or value:match("كيلو") or value:match("kg") or value:match("جم") then
	                        weightText = value
	                    end
	                    if isLegend then
	                        legendText = legendText or value
	                    else
	                        table.insert(names, value)
	                    end
	                end
	            end
	        end
	    end
	    return names, legend, legendText, weightText
	end

	local function trackBillboards(container)
	    if not container then return end
	    for _, descendant in ipairs(container:GetDescendants()) do
	        if descendant:IsA("BillboardGui") then billboardSet[descendant] = true end
	    end
	    connect(container.DescendantAdded, function(descendant)
	        if descendant:IsA("BillboardGui") then billboardSet[descendant] = true end
	    end)
