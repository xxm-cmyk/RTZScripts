-- Fetch current Discord avatars on every script launch (no periodic timer).
local HttpService = game:GetService("HttpService")
local AVATAR_API = "https://j6zy6t92cw.apps.bot-hosting.cloud/api/community/developers"
local developerAvatarUrls = {}

local function fetchDeveloperAvatars()
	local ok = pcall(function()
		if not request then error("HTTP request unavailable") end
		local response = request({
			Url = AVATAR_API .. "?_=" .. tostring(os.time()),
			Method = "GET",
			Headers = { ["Cache-Control"] = "no-cache", ["Pragma"] = "no-cache" }
		})
		if not response or not response.Success then error("Avatar API unavailable") end
		local payload = HttpService:JSONDecode(response.Body)
		if type(payload) ~= "table" or payload.ok ~= true or type(payload.developers) ~= "table" then
			error("Invalid avatar API response")
		end
		for _, developer in ipairs(payload.developers) do
			if type(developer.id) == "string" and type(developer.avatarUrl) == "string"
				and developer.avatarUrl:match("^https://cdn%.discordapp%.com/") then
				developerAvatarUrls[developer.id] = developer.avatarUrl
			end
		end
	end)
	return ok
end

fetchDeveloperAvatars()

local function getDeveloperAsset(id, fallback)
	local url = developerAvatarUrls[id]
	if url then
		-- Hash-specific filename prevents an older local image from being reused.
		local hash = url:match("/avatars/" .. id .. "/([^?%.]+)") or url:match("/embed/avatars/([^?%.]+)")
		local ext = url:match("/avatars/" .. id .. "/a_[^?]+%.gif") and "gif" or "png"
		local fileName = "rtz_avatar_" .. id .. "_" .. tostring(hash or "default") .. "." .. ext
		local asset = getCustomAsset(url, fileName)
		if asset ~= "" then return asset end
	end
	return getCustomAsset(fallback[1], fallback[2])
end

