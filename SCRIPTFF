	local function refreshList()
	    local origin = getOrigin()
	    if not origin or not listFrame then return end
	    local sorted, lizardCount, rareCount = {}, 0, 0
	    for _, rec in pairs(recs) do
	        if rec.pos then
	            rec.dist = (rec.pos - origin.Position).Magnitude
	            lizardCount += 1
	            if rec.rare then rareCount += 1 end
	            table.insert(sorted, rec)
	        end
	    end
	    table.sort(sorted, function(a, b)
	        if a.rare ~= b.rare then return a.rare end
	        return a.dist < b.dist
	    end)

	    local keep = {}
	    for index, rec in ipairs(sorted) do
	        if index > MAX_ROWS then break end
	        keep[rec] = true
	        local row = rows[rec]
	        if not row then
	            row = makeRow(rec)
	            rows[rec] = row
	        end
	        row.frame.LayoutOrder = index
	        row.name.Text = (rec.rare and "★ " or "") .. rec.name
	        row.name.TextColor3 = rec.rare and C.gold or C.text
	        row.sub.Text = rec.type .. "  •  " .. rec.tierNum .. (rec.weight and ("  •  " .. rec.weight) or "")
	        row.bar.BackgroundColor3 = rec.rare and C.gold or C.cyan
	        row.dist.Text = math.floor(rec.dist) .. " م"
	        row.dist.TextColor3 = rec.rare and C.gold or C.cyan

	        if selected == rec then
	            row.frame.BackgroundColor3 = SELECTED_BG
	            row.stroke.Color = C.pink
	            row.stroke.Thickness = 2
	            row.stroke.Transparency = 0
	        else
	            local base = rec.rare and RARE_ROW_BG or C.card
	            if row.frame.BackgroundColor3 == SELECTED_BG then
	                row.frame.BackgroundColor3 = base
	            end
	            row.stroke.Color = rec.rare and C.gold or C.stroke
	            row.stroke.Thickness = 1
	            if not rec.rare then row.stroke.Transparency = 0.3 end
	        end
	    end
	    for rec, row in pairs(rows) do
	        if not keep[rec] then
	            row.frame:Destroy()
	            rows[rec] = nil
	            if selected == rec then selected = nil end
	        end
	    end

	    if statCount then setStat(statCount, lizardCount) end
	    if statRare then setStat(statRare, rareCount) end

	    if not sweeping then
	        if statusNote and os.clock() < noteUntil then
	            statusLabel.Text = statusNote
	        else
	            statusLabel.Text = lizardCount == 0 and "لا يوجد ضبان حولك حالياً" or "جاهز"
	        end
	    end
	end


