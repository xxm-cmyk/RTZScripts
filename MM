getgenv().PhantomXLicenseKey = "BYPASS"

-- 2. تجهيز استجابة وهمية ناجحة تخدع السكربت والسيرفر
local FAKE_RESPONSE = {
    Success = true, 
    StatusCode = 200, 
    Body = '{"success":true,"valid":true,"sessionToken":"bypass_token","license":{"status":"active"}}'
}

-- 3. دالة للتحقق إذا كان الطلب الموجه للسيفر يخص الترخيص
local function isLicenseRequest(url) 
    return type(url) == "string" and url:find("license", 1, true) 
end

-- 4. اعتراض وتعديل دوال إرسال الطلبات بحسب الـ Executor الذي تستخدمه
if syn and syn.request then
    local original_request = syn.request
    syn.request = function(reqTable) 
        if isLicenseRequest(reqTable.Url) then
            return FAKE_RESPONSE
        end
        return original_request(reqTable)
    end
end

if http_request then
    local original_http = http_request
    http_request = function(reqTable) 
        if isLicenseRequest(reqTable.Url) then
            return FAKE_RESPONSE
        end
        return original_http(reqTable)
    end
    getgenv().http_request = http_request
end

if request then
    local original_req = request
    request = function(reqTable) 
        if isLicenseRequest(reqTable.Url) then
            return FAKE_RESPONSE
        end
        return original_req(reqTable)
    end
    getgenv().request = request
end

